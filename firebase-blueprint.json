{
  "entities": {
    "CompanyInfo": {
      "title": "Company Information",
      "description": "General information about the company",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "slogan": { "type": "string" },
        "description": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "instagram": { "type": "string" },
        "blog": { "type": "string" },
        "youtube": { "type": "string" }
      },
      "required": ["name", "phone"]
    },
    "ServiceItem": {
      "title": "Service Item",
      "description": "A service offered by the company",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "details": { "type": "array", "items": { "type": "string" } },
        "icon": { "type": "string" },
        "image": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["title", "description"]
    },
    "PortfolioItem": {
      "title": "Portfolio Item",
      "description": "A past project or case study",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "beforeImage": { "type": "string" },
        "afterImage": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "beforeImage", "afterImage", "description"]
    }
  },
  "firestore": {
    "/company/info": {
      "schema": "CompanyInfo",
      "description": "The company's basic information"
    },
    "/services/{serviceId}": {
      "schema": "ServiceItem",
      "description": "List of services"
    },
    "/portfolio/{portfolioId}": {
      "schema": "PortfolioItem",
      "description": "List of portfolio items"
    }
  }
}
